rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Registered users collection across all websites and domains
    match /registered_users/{userId} {
      allow read, write: if true;
    }

    // Site settings (e.g. app name, logo, bKash & Nagad numbers)
    match /site_settings/{docId} {
      allow read, write: if true;
    }

    // Payment verification requests (Bkash / Nagad 100 Taka)
    match /payment_requests/{paymentId} {
      allow read, write: if true;
    }

    // User profile document and subcollections
    match /users/{userId} {
      allow read, write: if true;

      // User cloud files subcollection
      match /files/{fileId} {
        allow read, write: if true;
      }

      // User storage usage subcollection
      match /storage/{docId} {
        allow read, write: if true;
      }
    }
  }
}
